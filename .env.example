# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials, and never paste them
# into a chat, an issue, or a screenshot.

# ---------------------------------------------------------------------------
# Instagram
# ---------------------------------------------------------------------------

# Access token generated in the Meta app dashboard:
#   Instagram > API setup with Instagram business login > Generate token
# Dashboard tokens are long-lived (60 days) and must be refreshed before expiry.
IG_ACCESS_TOKEN=

# Your Instagram user id. Read it with your own token:
#   curl "https://graph.instagram.com/v23.0/me?fields=user_id,username&access_token=YOUR_TOKEN"
IG_USER_ID=

# Login route. Leave unset for "Instagram API with Instagram Login" (no Facebook
# Page needed). Set to `facebook` only if you set the app up with Facebook Login
# for Business, which also requires a linked Facebook Page.
# IG_LOGIN_MODE=facebook

# Graph API version. Override only if Meta deprecates the default.
# IG_API_VERSION=v23.0

# ---------------------------------------------------------------------------
# Cloudflare R2 (image hosting)
# ---------------------------------------------------------------------------
# Instagram downloads the image from a public URL, so uploads land in R2 first.

# Cloudflare dashboard > R2 > Overview (shown in the sidebar as "Account ID")
R2_ACCOUNT_ID=

# R2 > Manage API tokens > Create token, with "Object Read & Write" on the bucket.
# Copy both values immediately — the secret is shown only once.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket name you created.
R2_BUCKET=

# The bucket's public base URL, with no trailing path.
#   r2.dev (development):  https://pub-xxxxxxxx.r2.dev
#   custom domain (prod):  https://cdn.your-domain.com
# r2.dev is rate-limited by Cloudflare and is not meant for production traffic.
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Claude (writes the post copy from the image)
# ---------------------------------------------------------------------------
# console.anthropic.com > API keys > Create key
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional hardening
# ---------------------------------------------------------------------------
# Restrict which origin may call the functions. Defaults to * for local dev;
# set this to your deployed site URL in production.
# ALLOWED_ORIGIN=https://your-site.netlify.app
